# Optional live strategy mode. Demo mode is the default and needs no secrets.
AFTERPLAY_ENABLE_LIVE_AI=false
OPENAI_API_KEY=
AFTERPLAY_OPENAI_MODEL=gpt-5.6-sol

# Optional Python clipper integration. Paths are relative to the Afterplay repo root.
# Studio reads the newest manifest from AFTERPLAY_CLIPPER_WORKDIR when one exists.
AFTERPLAY_CLIPPER_WORKDIR=services/video-clipper/.work

# Optional local runtime paths for running the nested clipper service.
AFTERPLAY_WORKDIR=services/video-clipper/.work
AFTERPLAY_OUTDIR=services/video-clipper/.out
AFTERPLAY_MEMORY=services/video-clipper/.memory
AFTERPLAY_CLIPPER_MODEL=gpt-5.6-sol

# Creator id the app writes recorded results under, for the ranking feedback loop.
# MUST match the --creator passed to `afterplay run`, or results land in a directory the
# clipper never reads and the loop silently does nothing.
AFTERPLAY_CREATOR_ID=demo_live

# Optional Anthropic policy for `afterplay run --llm`.
ANTHROPIC_API_KEY=

# Optional: folder of local media files, named <video_id>.<ext>, paired with
# services/video-clipper/.demo-cache/<video_id>/ captions for a network-free run.
AFTERPLAY_MEDIA_DIR=
