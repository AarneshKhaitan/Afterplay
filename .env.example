# Optional live strategy mode. Demo mode is the default and needs no secrets.
AFTERPLAY_ENABLE_LIVE_AI=true
OPENAI_API_KEY=
AFTERPLAY_OPENAI_MODEL=gpt-5.6-sol
# Riff live voice uses gpt-realtime-2.1 when OPENAI_API_KEY is present.

# Optional Python clipper integration. Paths are relative to the Afterplay repo root.
# Studio reads the newest manifest from AFTERPLAY_CLIPPER_WORKDIR when one exists.
AFTERPLAY_CLIPPER_WORKDIR=services/video-clipper/.work

# Optional local runtime paths for running the nested clipper service.
AFTERPLAY_WORKDIR=services/video-clipper/.work
AFTERPLAY_OUTDIR=services/video-clipper/.out
AFTERPLAY_MEMORY=services/video-clipper/.memory
AFTERPLAY_CLIPPER_MODEL=gpt-5.6-sol
AFTERPLAY_EXPERIMENT_DIR=.afterplay/experiments
# Deterministic transcript selection, in priority order. Every language listed is
# requested together, so one unavailable track fails the whole video -- keep this list
# to tracks the source actually has. YouTube rate-limits some non-English tracks and
# answers 429, which surfaces as "no captions"; `hi` was observed failing this way on
# sources whose `en` track resolved in the same minute. The manifest records the
# language and track actually used.
AFTERPLAY_SUBTITLE_LANGUAGES=en,en-US,en-GB,en-orig
AFTERPLAY_ASR_LANGUAGE=en

# Optional first-run creator override. Leave unset unless you need a local default before
# selecting a workspace in the UI.
# AFTERPLAY_CREATOR_ID=

# Optional Anthropic policy for `afterplay run --llm`.
ANTHROPIC_API_KEY=

# Optional: folder of local media files, named <video_id>.<ext>, paired with
# services/video-clipper/.demo-cache/<video_id>/ captions for a network-free run.
AFTERPLAY_MEDIA_DIR=

# Competitive intelligence. Required by Intel scans, which call a paid Apify actor --
# a scan spends money. Absent, Intel renders a cold state and never bills.
APIFY_API_TOKEN=
AFTERPLAY_INTEL_DIR=.intel
AFTERPLAY_INTEL_MODEL=gpt-5.6-sol

# Mode override. Normally the selected workspace decides (demo or live); these force it.
# AFTERPLAY_MODE_LOCK=true makes AFTERPLAY_MODE win over the workspace record.
# AFTERPLAY_MODE=live
# AFTERPLAY_MODE_LOCK=false

# Vertical framing. Fraction of the source width kept before letterboxing: 1.0 keeps the
# whole frame and fills above/below with a blurred copy; lower values crop in first.
# AFTERPLAY_MIN_WIDTH_FRAC=1.0

# Binary and interpreter overrides. Both are auto-detected; set only to pin a specific one.
# AFTERPLAY_FFMPEG=
# AFTERPLAY_PYTHON=

# Offline captions cache, paired with AFTERPLAY_MEDIA_DIR for a network-free run.
# AFTERPLAY_DEMO_CACHE=services/video-clipper/.demo-cache

# Extraction pacing. YouTube throttles rapid unauthenticated extraction; these slow a
# batch down rather than letting it trip the limit.
# AFTERPLAY_RETRIES=3
# AFTERPLAY_SLEEP_INTERVAL=1
# AFTERPLAY_MAX_SLEEP_INTERVAL=5
