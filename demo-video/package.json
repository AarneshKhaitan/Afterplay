{
  "name": "afterplay-riff-demo-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audio": "node --env-file=../.env.local scripts/generate-audio.mjs",
    "audio:elevenlabs": "node --env-file=../.env.local scripts/generate-elevenlabs-audio.mjs",
    "studio": "remotion studio src/index.ts --no-open",
    "render": "remotion render src/index.ts AfterplayRiffDemo out/afterplay-riff-demo.mp4 --codec=h264 --crf=16"
  },
  "dependencies": {
    "@remotion/cli": "4.0.503",
    "@remotion/media": "4.0.503",
    "remotion": "4.0.503",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
